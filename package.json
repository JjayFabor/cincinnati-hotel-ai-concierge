{
  "name": "cincinnati-hotel-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "Cincinnati Hotel AI concierge: React frontend, Node.js backend, n8n-orchestrated AI workflows.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
